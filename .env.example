# Curf Community — copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up -d        # local Postgres on :5432, matches DATABASE_URL below
#
# The four values under "Required" are all a local install needs. Generate
# real secrets for anything you expose: `openssl rand -base64 32`.

# --- Required ---------------------------------------------------------------

# Postgres connection string. The compose file starts one with these credentials.
DATABASE_URL="postgres://curf:curf@localhost:5432/curf"

# The origin you serve the app at, no trailing slash. `npm run dev` listens on 3100.
NEXTAUTH_URL="http://localhost:3100"

# Session signing key.
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Protects POST /api/cron/tick, which runs scheduled deliveries. Call it every
# minute from any scheduler with this value in the `x-cron-secret` header.
CRON_SECRET="change-me-to-a-random-string"

# --- Required in production -------------------------------------------------

# Derives the AES-256-GCM key that encrypts stored credentials (data source
# passwords, SMTP passwords) at rest. Unset, the app falls back to a
# passphrase that is public in this repository. Changing it after secrets
# exist makes them unreadable — rotate by re-encrypting, never by swapping.
CURF_SECRET_KEY="change-me-generate-with-openssl-rand-base64-32"

# Signs embed tokens (the <iframe> report embed). Unset, the app falls back
# to a value that is public in this repository, so anyone could forge one.
CURF_EMBED_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- Optional ---------------------------------------------------------------

# Scheduled email delivery. Without these, email schedules are skipped.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Curf <reports@example.com>"

# Sign in with Google / GitHub. Register {NEXTAUTH_URL}/api/auth/callback/{google|github}.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# "Generate a report from a prompt" with your own Anthropic key. You can also
# paste a key per workspace under Admin → Tenant → LLM instead of setting it
# here. Without either, Generate says AI is not configured; everything else works.
# ANTHROPIC_API_KEY="sk-ant-..."
# CURF_LLM="anthropic"
# CURF_LLM_MODEL="claude-sonnet-4-6"
#
# Any other provider, e.g. Kimi (Moonshot) through the OpenAI-compatible
# driver. Defaults to kimi-k3 if CURF_LLM_MODEL is unset; not customer-
# facing — the workspace never sees which model is behind Curf AI.
# CURF_LLM_PROVIDER="openai-compatible"
# CURF_LLM_KEY="sk-..."
# CURF_LLM_BASE_URL="https://api.moonshot.ai/v1"
# CURF_LLM_MODEL="kimi-k3"

# Origin the server uses to call itself (PDF / XLSX export opens the viewer in
# headless Chromium). Defaults to NEXTAUTH_URL; set a cluster-local address
# to skip your ingress.
# INTERNAL_BASE_URL="http://127.0.0.1:3100"

# How many trusted proxies append to X-Forwarded-For before a request reaches
# the app (rate limits and audit rows key on the hop your proxy added, never
# on the client-supplied first entry). One ingress = 1; a CDN in front of it = 2.
# CURF_TRUSTED_PROXY_HOPS=1

# Where the file lake (CSV / XLSX / JSON uploads) is stored. Default: ./lake
# CURF_LAKE_DIR="./lake"

# Origin of the docs site linked from the landing page. Default: Curf Cloud's docs.
# DOCS_URL="https://app.curf.ai"
